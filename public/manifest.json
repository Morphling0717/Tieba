{
  "manifest_version": 3,
  "name": "假面骑士吧长帖审阅助手",
  "description": "非百度官方的贴吧长帖人工审阅助手。读取当前帖可见文字，经用户确认后可向所选 AI 服务商发送本地脱敏内容并生成待复核线索；不执行删除或封禁。",
  "version": "1.0.0",
  "minimum_chrome_version": "140",
  "permissions": ["scripting", "storage", "sidePanel"],
  "host_permissions": [
    "https://tieba.baidu.com/*",
    "https://ws-7ee35od4h2zs6dft.cn-beijing.maas.aliyuncs.com/*"
  ],
  "optional_host_permissions": [
    "https://api.deepseek.com/*",
    "http://localhost/*",
    "http://127.0.0.1/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "打开长帖审阅助手"
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+Shift+Y",
        "mac": "Command+Shift+Y"
      },
      "description": "打开长帖审阅助手"
    }
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  }
}
